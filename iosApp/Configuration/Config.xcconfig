TEAM_ID=UDTBP44Q7F
APP_BUNDLE_IDENTIFIER=com.nberezovskii.jukovplayer
APP_DISPLAY_NAME=the only player
APP_STORE_TEAM_ID=UDTBP44Q7F
APP_STORE_BUNDLE_IDENTIFIER=com.nberezovskii.jukovplayer
APP_STORE_PROVISIONING_PROFILE=Jukovplayer App Store
// Developers from another Apple team can override TEAM_ID and
// APP_BUNDLE_IDENTIFIER for Debug builds in the gitignored Local.xcconfig.
// App Store Release identity stays fixed. Firebase Crashlytics symbol upload is
// enabled only when GoogleService-Info.plist matches the resolved Bundle ID.
#include? "Local.xcconfig"

PRODUCT_NAME=Jukovplayer
PRODUCT_BUNDLE_IDENTIFIER=$(APP_BUNDLE_IDENTIFIER)

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0
